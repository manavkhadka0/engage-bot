# Engage Bot backend — local development settings.
#
# DO NOT put real secrets in this file: it is committed. Run
#     pnpm setup:env
# (from engage-bot-backend/) to create the untracked `.env` next to it: blank
# secrets below are filled with random per-machine values, {{NAME}} placeholders
# are resolved, and S3_PUBLIC_ENDPOINT gets this machine's LAN IP. Existing
# non-blank values in `.env` are never overwritten.
# docker-compose.yml reads POSTGRES_*, MINIO_*, EMQX_* from that same `.env`.

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Frontend origin(s) — comma-separated
CORS_ORIGINS=http://localhost:3001

# ── Local infrastructure (docker-compose) ──
POSTGRES_PASSWORD=
MINIO_ROOT_USER=engage_bot
MINIO_ROOT_PASSWORD=
EMQX_DASHBOARD_PASSWORD=
EMQX_NODE_COOKIE=

# Postgres (Timescale via docker-compose)
DATABASE_URL=postgresql://engage_bot:{{POSTGRES_PASSWORD}}@localhost:5432/engage_bot?schema=public

# Redis (BullMQ / presence later)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage. Local dev: MinIO from docker-compose. Hosted:
# Cloudflare R2 / Backblaze B2 free tier — see team/COOLIFY_DEPLOY.md, and verify
# any setup with `pnpm storage:check`.
#   R2: S3_ENDPOINT=S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
# Presigned download URLs handed to devices use this instead — must be
# reachable from the device's network, not just this machine. Locally that is
# this machine's CURRENT LAN IP (it changes with DHCP: re-run `pnpm setup:env`
# after clearing this value). In production use the public HTTPS URL of the store.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID={{MINIO_ROOT_USER}}
S3_SECRET_ACCESS_KEY={{MINIO_ROOT_PASSWORD}}
S3_BUCKET=engage-bot
S3_FORCE_PATH_STYLE=true

# EMQX MQTT
# These identify the backend itself to EMQX as a superuser (bypasses
# per-device ACL — see src/modules/mqtt-auth). Devices authenticate
# separately with serial+provisionToken, not this credential.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=engage-bot-backend
MQTT_PASSWORD=

# BetterAuth — when frontend proxies /api/auth, set to the frontend origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Production only: parent domain WITH a leading dot (e.g. .example.com) so the
# login cookie (set via app.<domain>) is also sent to api.<domain>, which the
# realtime websocket needs. Leave unset locally (localhost cookies ignore ports).
# COOKIE_DOMAIN=.example.com

# First platform owner, created by `pnpm seed:platform`. The password is
# generated into your `.env` — read it there (it is never printed or committed).
PLATFORM_EMAIL=admin@baliyo.ventures
PLATFORM_PASSWORD=

# Resend (email). Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Engage Bot <noreply@example.com>
# Where marketing-site demo request notifications go
LEADS_EMAIL=hello@example.com
