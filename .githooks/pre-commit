#!/bin/sh
# Blocks a commit when the staged changes contain a secret (WiFi/MQTT credentials
# in firmware, literal passwords in config, provider tokens, private keys...).
# Enable once per clone:  sh scripts/install-git-hooks.sh
# Emergency bypass (think twice): SKIP_SECRET_SCAN=1 git commit ...
[ "${SKIP_SECRET_SCAN:-}" = "1" ] && exit 0

root="$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so secrets can't be checked." >&2
  echo "  macOS:  brew install gitleaks      (others: https://github.com/gitleaks/gitleaks#installing)" >&2
  echo "  Bypass once (not recommended): SKIP_SECRET_SCAN=1 git commit ..." >&2
  exit 1
fi

if ! gitleaks git --staged --redact --no-banner --config "$root/.gitleaks.toml" >/dev/null 2>&1; then
  echo >&2
  echo "Commit blocked: gitleaks found what looks like a secret in your staged changes." >&2
  echo "Details (values redacted):" >&2
  gitleaks git --staged --redact --no-banner --config "$root/.gitleaks.toml" 2>&1 | grep -E 'RuleID|File|Line' >&2
  echo >&2
  echo "Move it to an untracked file (.env, esp_audio/main/secrets.h) and read it from there." >&2
  echo "If it is a harmless placeholder, adjust .gitleaks.toml. Policy: SECURITY.md" >&2
  exit 1
fi
exit 0
