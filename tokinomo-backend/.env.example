# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Frontend origin(s) — comma-separated
CORS_ORIGINS=http://localhost:3001

# Postgres (Timescale via docker-compose)
DATABASE_URL=postgresql://tokinomo:***REMOVED***@localhost:5432/tokinomo?schema=public

# Redis (BullMQ / presence later)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage. Local dev: MinIO from docker-compose (values
# below). Hosted: Cloudflare R2 / Backblaze B2 free tier — see
# team/COOLIFY_DEPLOY.md, and verify any setup with `pnpm storage:check`.
#   R2: S3_ENDPOINT=S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
# Presigned download URLs handed to devices use this instead — must be
# reachable from the device's network, not just this machine. Locally that
# is this machine's CURRENT LAN IP (it changes with DHCP — a stale value
# means uploads work but devices can't download). In production use the
# public HTTPS URL of the object store.
S3_PUBLIC_ENDPOINT=http://192.168.1.50:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tokinomo
S3_SECRET_ACCESS_KEY=***REMOVED***
S3_BUCKET=tokinomo
S3_FORCE_PATH_STYLE=true

# EMQX MQTT
# These identify the backend itself to EMQX as a superuser (bypasses
# per-device ACL — see src/modules/mqtt-auth). Devices authenticate
# separately with serial+provisionToken, not this credential.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=tokinomo-backend
MQTT_PASSWORD=change-me-to-a-long-random-string

# BetterAuth — when frontend proxies /api/auth, set to the frontend origin
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
# Production only: parent domain WITH a leading dot (e.g. .example.com) so the
# login cookie (set via app.<domain>) is also sent to api.<domain>, which the
# realtime websocket needs. Leave unset locally (localhost cookies ignore ports).
# COOKIE_DOMAIN=.example.com

# Resend (email — wired later)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tokinomo <noreply@example.com>
# Where marketing-site demo request notifications go
LEADS_EMAIL=hello@example.com
