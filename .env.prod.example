# Variables for docker-compose.prod.yml — set these in Coolify (resource → Environment Variables).
# Never commit real values. Secrets named SERVICE_PASSWORD_64_* are generated by
# Coolify itself (magic variables) — do NOT set them by hand.

# ── Hostnames (no scheme). DNS: A records → the VPS IP, "DNS only" if on Cloudflare ──
APP_DOMAIN=app.example.com          # dashboard (web)
API_DOMAIN=api.example.com          # API + websocket
MQTT_DOMAIN=mqtt.example.com        # device broker (mqtts, port 8883)
COOKIE_DOMAIN=.example.com          # parent domain WITH leading dot — shares the login cookie with the API host

# ── Object storage (Cloudflare R2 example; see team/COOLIFY_DEPLOY.md) ──
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tokinomo
S3_FORCE_PATH_STYLE=true

# ── Email (Resend; the sending domain must be verified in Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tokinomo <noreply@example.com>
LEADS_EMAIL=you@example.com         # where "Book a demo" requests are sent

# ── First platform owner (used once by the seed command; pick a strong password) ──
PLATFORM_EMAIL=you@example.com
PLATFORM_PASSWORD=
PLATFORM_NAME=Platform Owner

# ── Optional ──
# IMAGE_PREFIX=ghcr.io/<github-owner>/tokinomo   # default: ghcr.io/manavkhadka0/tokinomo
# IMAGE_TAG=latest                               # pin to sha-<short> to roll back
# BACKUP_HOUR_UTC=3
# BACKUP_KEEP_DAYS=14
